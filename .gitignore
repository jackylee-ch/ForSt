/target
**/*.rs.bk

# Locally-downloaded developer tools (not committed)
/actionlint

# planning-with-files skill scratchpads (skill writes to repo root by default).
# These are session-local; authoritative planning lives in .planning/refactor-review/
# and docs/superpowers/planning/.
/findings.md
/progress.md
/task_plan.md

# Stray run/snapshot logs must never be committed (may capture substituted S3 secrets)
docs/superpowers/specs/*.log

# Build/index/session artifacts + bench OUTPUT data — never tracked (kept out of
# the working-tree "loose state" that otherwise lingers every `git status`).
/.codegraph/
/.claude/
/META-INF/
/org/
docs/superpowers/specs/v5-bench-data/
target-linux/
